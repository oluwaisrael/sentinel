{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Notifications": {
    "PollIntervalMilliseconds": 1000,
    "MaxConcurrency": 2,
    "LeaseDurationSeconds": 60,
    "MaxAttempts": 5,
    "RetryBaseDelaySeconds": 30
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "",
    "UseSsl": true
  },
  "Monitoring": {
    "PollIntervalMilliseconds": 1000,
    "MaxConcurrency": 4,
    "LeaseDurationSeconds": 30,
    "SupportedIntervalSeconds": 60
  }
}
